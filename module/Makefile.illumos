#
# OpenZFS kernel module build for illumos.
#
# Usage:
#   gmake -f module/Makefile.illumos [UTS=path/to/uts]
#
# This produces a single kernel module 'zfs' suitable for modload(8).
#

SRCDIR		= $(CURDIR)/module
INCDIR		= $(CURDIR)/include
UTS		?= /opt/openzfs_build/smartos-live/projects/illumos/usr/src/uts

MODULE		= zfs
OBJDIR		= obj-illumos
BINARY		= $(OBJDIR)/$(MODULE)

CC		= gcc
LD		= ld
CTFCONVERT	= /opt/onbld/bin/i386/ctfconvert
CTFMERGE	= /opt/onbld/bin/i386/ctfmerge

#
# Kernel compilation flags (from uts/Makefile.uts + uts/intel/Makefile.intel)
#
KCFLAGS		= -m64 -std=gnu11
KCFLAGS		+= -ffreestanding -fno-builtin -fno-strict-aliasing -fno-common
KCFLAGS		+= -mno-red-zone -mcmodel=kernel
KCFLAGS		+= -fno-omit-frame-pointer
KCFLAGS		+= -Wall -Wno-missing-braces -Wno-sign-compare
KCFLAGS		+= -Wno-unused-parameter -Wno-missing-field-initializers
KCFLAGS		+= -Wno-type-limits -Wno-switch -Wno-parentheses
KCFLAGS		+= -Wno-unused-variable -Wno-unused-function
KCFLAGS		+= -O2

#
# Kernel preprocessor defines
#
KDEFS		= -D_KERNEL -D__KERNEL__
KDEFS		+= -D_SYSCALL32 -D_SYSCALL32_IMPL -D_ELF64 -D_DDI_STRICT
KDEFS		+= -Dsun -D__sun -D__SVR4 -D__illumos__
KDEFS		+= -DBUILDING_ZFS -DHAVE_CONFIG_H
KDEFS		+= -DHAVE_KSID
KDEFS		+= -DTEXT_DOMAIN=\"zfs-illumos-kernel\"
# SIMD feature flags — illumos x86_64 kernels support these ISA extensions.
# The HAVE_KERNEL_* defines tell OpenZFS that the kernel can use them.
KDEFS		+= -DHAVE_KERNEL_SSE2 -DHAVE_KERNEL_SSSE3
KDEFS		+= -DHAVE_KERNEL_SSE4_1 -DHAVE_KERNEL_AVX
KDEFS		+= -DHAVE_KERNEL_AVX2 -DHAVE_KERNEL_AVX512F
KDEFS		+= -DHAVE_KERNEL_AVX512BW -DHAVE_KERNEL_AVX512VL
KDEFS		+= -DHAVE_KERNEL_AES -DHAVE_KERNEL_PCLMULQDQ
KDEFS		+= -DHAVE_KERNEL_MOVBE -DHAVE_KERNEL_FMA

#
# Include paths — order matters for #include_next chaining
#
KINC		= -include $(CURDIR)/zfs_config.h
KINC		+= -include $(INCDIR)/sys/simd_config.h
KINC		+= -I$(INCDIR)/os/illumos/spl
KINC		+= -I$(INCDIR)/os/illumos/zfs
KINC		+= -I$(SRCDIR)/icp/include
KINC		+= -I$(INCDIR)
KINC		+= -I$(UTS)/common
KINC		+= -I$(UTS)/intel
KINC		+= -I$(UTS)/i86pc
KINC		+= -I$(UTS)/common/fs/zfs
KINC		+= -I$(SRCDIR)/zstd/include
KINC		+= -I$(CURDIR)/lib/libspl/include/os/illumos

CFLAGS		= $(KCFLAGS) $(KDEFS) $(KINC)

#
# Linker flags for kernel module
#
LDFLAGS		= -ztype=kmod -64
LDFLAGS		+= -Nfs/specfs -Ncrypto/swrand -Nmisc/idmap
LDFLAGS		+= -Nmisc/sha2 -Nmisc/skein -Nmisc/edonr

# ============================================================
# Source file lists
# ============================================================

#
# Platform-neutral ZFS core (module/zfs/)
#
ZFS_SRCS = \
